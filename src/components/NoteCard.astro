---
import TagBadge from './TagBadge.astro';
import { url } from '../utils/url';

interface Props {
  slug: string;
  title: string;
  tags: string[];
  type?: 'problem-solving' | 'insight' | 'learning' | 'reference';
  created?: string;
  readingTime?: number;
}

const { slug, title, tags, type, created, readingTime } = Astro.props;

const typeConfig = {
  'problem-solving': { label: '🔧 문제해결', cls: 'bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400' },
  'insight':         { label: '💡 인사이트', cls: 'bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-400' },
  'learning':        { label: '📚 학습',     cls: 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400' },
  'reference':       { label: '📎 참고',     cls: 'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400' },
};

const typeInfo = type ? typeConfig[type] : null;
---

<article
  data-type={type ?? ''}
  class="group rounded-lg border border-gray-200 dark:border-gray-800
         bg-white dark:bg-gray-800/50 p-4
         hover:border-indigo-300 dark:hover:border-indigo-700 transition-colors"
>
  <div class="flex items-start justify-between gap-2 mb-1.5">
    <a href={url(`/notes/${slug}`)} class="block flex-1 min-w-0">
      <h2
        class="text-sm font-medium text-gray-900 dark:text-gray-100
               group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors"
      >
        {title}
      </h2>
    </a>
    {typeInfo && (
      <span class={`shrink-0 rounded-full px-2 py-0.5 text-xs font-medium ${typeInfo.cls}`}>
        {typeInfo.label}
      </span>
    )}
  </div>
  <div class="flex items-center justify-between gap-2">
    <div class="flex flex-wrap gap-1.5">
      {tags.map(tag => <TagBadge tag={tag} />)}
    </div>
    <div class="flex shrink-0 items-center gap-2 text-xs text-gray-400 dark:text-gray-500">
      {readingTime && <span>{readingTime}분</span>}
      {created && <time datetime={created}>{created}</time>}
    </div>
  </div>
</article>
