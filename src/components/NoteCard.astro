---
import TagBadge from './TagBadge.astro';
import { url } from '../utils/url';

interface Props {
  slug: string;
  title: string;
  tags: string[];
  created?: string;
  readingTime?: number;
}

const { slug, title, tags, created, readingTime } = Astro.props;
---

<article
  class="group rounded-lg border border-gray-200 dark:border-gray-800
         bg-white dark:bg-gray-800/50 p-4
         hover:border-indigo-300 dark:hover:border-indigo-700 transition-colors"
>
  <a href={url(`/notes/${slug}`)} class="block">
    <h2
      class="text-sm font-medium text-gray-900 dark:text-gray-100
             group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors"
    >
      {title}
    </h2>
  </a>
  <div class="mt-2.5 flex items-center justify-between gap-2">
    <div class="flex flex-wrap gap-1.5">
      {tags.map(tag => <TagBadge tag={tag} />)}
    </div>
    <div class="flex shrink-0 items-center gap-2 text-xs text-gray-400 dark:text-gray-500">
      {readingTime && <span>{readingTime}분</span>}
      {created && <time datetime={created}>{created}</time>}
    </div>
  </div>
</article>
