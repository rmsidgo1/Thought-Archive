---
import { getCollection } from 'astro:content';
import { url } from '../utils/url';

interface Props {
  currentSlug: string;
  tags: string[];
  backlinks: string[];
  links: string[];
}

const { currentSlug, tags, backlinks, links } = Astro.props;

const allNotes = await getCollection('notes');

const related = allNotes
  .filter(note => note.slug !== currentSlug)
  .map(note => {
    const sharedTags = note.data.tags.filter(t => tags.includes(t)).length;
    // 이 노트가 링크하는 곳이거나, 역링크인 경우 점수 추가
    const isLinked =
      (links.includes(note.slug) ? 1 : 0) +
      (backlinks.includes(note.slug) ? 1 : 0);
    return { note, score: sharedTags + isLinked };
  })
  .filter(({ score }) => score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 5)
  .map(({ note }) => note);
---

{
  related.length > 0 && (
    <section class="mt-8 border-t border-gray-200 dark:border-gray-800 pt-8">
      <h2 class="mb-4 text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">
        관련 노트
      </h2>
      <ul class="space-y-1.5">
        {related.map(note => (
          <li>
            <a
              href={url(`/notes/${note.slug}`)}
              class="text-sm text-indigo-600 dark:text-indigo-400 hover:underline"
            >
              {note.data.title}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
