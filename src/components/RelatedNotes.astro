---
import { getCollection } from 'astro:content';
import { url } from '../utils/url';

interface Props {
  currentSlug: string;
  tags: string[];
  backlinks: string[];
  links: string[];
}

const { currentSlug, tags, backlinks, links } = Astro.props;

const allNotes = await getCollection('notes');

const related = allNotes
  .filter(note => note.slug !== currentSlug)
  .map(note => {
    const sharedTags = note.data.tags.filter(t => tags.includes(t));
    const linkedFrom = links.includes(note.slug);
    const linksBack = backlinks.includes(note.slug);
    const score = sharedTags.length + (linkedFrom ? 1 : 0) + (linksBack ? 1 : 0);

    // 관계 이유 레이블
    const reasons: string[] = [];
    if (linkedFrom)          reasons.push('링크됨');
    if (linksBack)           reasons.push('역링크');
    if (sharedTags.length)   reasons.push(`태그 ${sharedTags.length}개 공유`);

    return { note, score, reason: reasons[0] ?? '' };
  })
  .filter(({ score }) => score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 5);
---

{
  related.length > 0 && (
    <section class="mt-8 border-t border-gray-200 dark:border-gray-800 pt-8">
      <h2 class="mb-4 text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">
        관련 노트
      </h2>
      <ul class="space-y-2">
        {related.map(({ note, reason }) => (
          <li class="flex items-center justify-between gap-3">
            <a
              href={url(`/notes/${note.slug}`)}
              class="text-sm text-indigo-600 dark:text-indigo-400 hover:underline truncate"
            >
              {note.data.title}
            </a>
            {reason && (
              <span class="shrink-0 text-xs text-gray-400 dark:text-gray-500">
                {reason}
              </span>
            )}
          </li>
        ))}
      </ul>
    </section>
  )
}
