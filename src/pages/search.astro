---
import BaseLayout from '../layouts/BaseLayout.astro';

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout title="검색" description="노트 전문 검색">
  <h1 class="mb-6 text-2xl font-semibold text-gray-900 dark:text-gray-100">검색</h1>

  <div id="search"></div>

  <!-- Pagefind UI — 빌드 후 생성된 파일을 동적으로 로드 -->
  <link href={`${baseUrl}pagefind/pagefind-ui.css`} rel="stylesheet" />
  <script define:vars={{ baseUrl }}>
    window.addEventListener('DOMContentLoaded', async () => {
      try {
        // @ts-ignore — pagefind은 빌드 후에만 존재
        const { PagefindUI } = await import(`${baseUrl}pagefind/pagefind-ui.js`);
        new PagefindUI({
          element: '#search',
          showSubResults: true,
          showImages: false,
          resetStyles: false,
          translations: {
            placeholder: '검색어를 입력하세요...',
            zero_results: '[SEARCH_TERM]에 대한 결과가 없습니다.',
          },
        });
      } catch {
        document.getElementById('search')!.innerHTML =
          '<p class="text-sm text-gray-500 dark:text-gray-400 mt-4">개발 모드에서는 검색을 사용할 수 없습니다.<br><code class="bg-gray-100 dark:bg-gray-800 px-1 rounded">npm run build && npm run preview</code>로 확인하세요.</p>';
      }
    });
  </script>
</BaseLayout>

<style is:global>
  .pagefind-ui__search-input {
    @apply w-full rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 px-4 py-2 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-500;
  }
  .pagefind-ui__result {
    @apply mt-4 rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-800/50 p-4;
  }
  .pagefind-ui__result-title {
    @apply text-sm font-medium text-indigo-600 dark:text-indigo-400;
  }
  .pagefind-ui__result-excerpt {
    @apply mt-1 text-xs text-gray-500 dark:text-gray-400;
  }
</style>
