---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteCard from '../../components/NoteCard.astro';
import { getAllTags, getNotesByTag } from '../../utils/tags';
import { getReadingTime } from '../../utils/reading-time';

export async function getStaticPaths() {
  const tagMap = await getAllTags();
  return [...tagMap.keys()].map(tag => ({ params: { tag } }));
}

const { tag } = Astro.params;
const notes = await getNotesByTag(tag);

const sorted = [...notes].sort((a, b) => {
  const da = a.data.created ?? '0000-00-00';
  const db = b.data.created ?? '0000-00-00';
  return db.localeCompare(da);
});
---

<BaseLayout title={`#${tag}`} description={`"${tag}" 태그가 붙은 노트`}>
  <h1 class="mb-1 text-2xl font-semibold text-gray-900 dark:text-gray-100">#{tag}</h1>
  <p class="mb-8 text-sm text-gray-500 dark:text-gray-400">{notes.length}개의 노트</p>

  <div class="space-y-2.5">
    {
      sorted.map(note => (
        <NoteCard
          slug={note.slug}
          title={note.data.title}
          tags={note.data.tags}
          created={note.data.created}
          readingTime={getReadingTime(note.body)}
        />
      ))
    }
  </div>
</BaseLayout>
