---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags } from '../../utils/tags';
import { url } from '../../utils/url';

const tagMap = await getAllTags();
const tags = [...tagMap.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="태그" description="모든 태그 목록">
  <h1 class="mb-8 text-2xl font-semibold text-gray-900 dark:text-gray-100">태그</h1>

  {
    tags.length === 0 ? (
      <p class="text-sm text-gray-500 dark:text-gray-400">아직 태그가 없습니다.</p>
    ) : (
      <div class="space-y-1.5">
        {tags.map(([tag, count]) => (
          <a
            href={url(`/tags/${tag}`)}
            class="flex items-center justify-between rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-800/50 px-4 py-3 hover:border-indigo-300 dark:hover:border-indigo-700 transition-colors"
          >
            <span class="font-medium text-gray-900 dark:text-gray-100">#{tag}</span>
            <span class="text-sm text-gray-500 dark:text-gray-400">{count}개</span>
          </a>
        ))}
      </div>
    )
  }
</BaseLayout>
